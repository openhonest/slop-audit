#!/bin/sh
# Chain to the machine-wide git hook.
#
# WHY THIS FILE EXISTS
# core.hooksPath is set locally in this repository, which REPLACES the global
# one and silently disabled both the Claude-attribution strip and the commit
# message check. Measured 2026-08-15: 249 commits across nine repositories had
# already landed with attribution because of it.
#
# The earlier fix was to copy the global shim in here. Three copies then
# drifted to three different contents, which is the same defect one layer up.
# This file delegates instead, so there is one implementation.
exec "$HOME/.config/git/hooks/$(basename "$0")" "$@"
