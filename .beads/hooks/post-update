#!/bin/sh
# Global git hook shim (core.hooksPath). Preserves repo-local hooks by delegating.
name=$(basename "$0")

if [ "$name" = "commit-msg" ]; then
    tmp="$1.strip.$$"
    if grep -ivE '^co-authored-by:.*(claude|anthropic)|^claude-session:|generated with.*claude' "$1" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$1"
    else
        rm -f "$tmp"
    fi
fi

# Run the repo's own hook of this name, if it has one (the real .git/hooks, not this dir).
common=$(git rev-parse --git-common-dir 2>/dev/null) || common=.git
local_hook="$common/hooks/$name"
if [ -x "$local_hook" ]; then
    exec "$local_hook" "$@"
fi
exit 0
